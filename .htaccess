Options -Indexes
DirectoryIndex index.php
RewriteEngine On
RewriteRule ^config\.php(?:[.~].*)?$ - [F,END,NC]
# Auch vor Regeln in Unterverzeichnissen ausführen (o7 hat eigene .htaccess).
RewriteOptions InheritDownBefore
RewriteCond %{REQUEST_URI} (^|/)o7(?:/|$) [NC]
RewriteRule ^ - [F,END]
# Die Referenz auf o7 und interne Projektdateien sind kein öffentlicher Inhalt.
RewriteRule ^(?:o7|app|bin|config|database|docs|tests|storage|\.git|\.agents|\.codex)(?:/|$) - [F,L]
RewriteRule ^(?:README\.md|AGENTS\.md|runcodex\.sh|router\.php|package\.json)$ - [F,L]
RewriteRule (^|/)\. - [F,L]
<IfModule mod_headers.c>
    <FilesMatch "\.(?:js|css)$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
</IfModule>
